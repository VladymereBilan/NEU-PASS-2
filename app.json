{
  "expo": {
    "name": "NEU-Pass",
    "slug": "neu-pass",
    "scheme": "neu-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/neu-logo.png",
    "splash": {
      "image": "./assets/branding/neu-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      "react-native-fast-tflite"
    ],
    "android": {
      "package": "com.vladymere.neupass",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/neu-logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba330c28-7d63-407f-9689-4fba2e3f3e1e"
      }
    },
    "owner": "vladymere"
  }
}
