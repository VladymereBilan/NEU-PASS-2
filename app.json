{
  "expo": {
    "name": "NEU-Pass",
    "slug": "neu-pass",
    "scheme": "neu-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": false,
    "icon": "./assets/branding/neu-logo.png",
    "splash": {
      "image": "./assets/branding/neu-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      "react-native-fast-tflite",
      "expo-font",
      "expo-asset"
    ],
    "android": {
      "package": "com.vladymere.neupass",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/neu-logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4a9e062-08aa-4edb-b90c-8c9e02e9ddef"
      }
    },
    "owner": "neu_bilan_vladymere"
  }
}
