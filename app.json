{
  "expo": {
    "name": "NEU-Pass",
    "slug": "neu-pass",
    "scheme": "neu-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": false,
    "icon": "./assets/branding/neu-pass-icon.png",
    "splash": {
      "image": "./assets/branding/neu-pass-adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7F4"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "NEU PASS uses the camera to scan visitor QR passes and capture a live photo for checkout face verification."
        }
      ]
    ],
    "android": {
      "package": "com.vladymere.neupass",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/neu-pass-adaptive-icon.png",
        "backgroundColor": "#F5F7F4"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "592d99b3-6f89-46c0-b8be-1804a3d1f292"
      }
    },
    "owner": "vsb.dev"
  }
}
