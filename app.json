{
  "expo": {
    "name": "NEU-Pass",
    "slug": "neu-pass",
    "scheme": "neu-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": false,
    "icon": "./assets/branding/neu-logo.png",
    "splash": {
      "image": "./assets/branding/neu-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "android": {
      "package": "com.vladymere.neupass",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/neu-logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a32f903-5b6d-4acf-81f8-7d0fbb6a4ebc"
      }
    },
    "owner": "neu_jamero_james"
  }
}
